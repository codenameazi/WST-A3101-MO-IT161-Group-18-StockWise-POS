<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= pageTitle %></title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header class="top-header">
        <h2><%= appName %></h2>
        <div class="user">USER</div>
    </header>

    <aside class="sidebar">

        <nav>
            <a href="/dashboard">HOME</a>
            <a href="/Order.html">ORDERS</a>
            <a href="/inventory" class="active">INVENTORY</a>
            <a href="/Reports.html">REPORTS</a>
            <a href="/Rewards.html">REWARD</a>

            <div class="sidebar-bottom">
                <a href="/Notifications.html">NOTIFICATIONS</a>
                <a href="/Settings.html">SETTINGS</a>

                <footer>
                    <a href="/login">LOGOUT</a>
                </footer>
            </div>
        </nav>

    </aside>

    <main class="inventory-page">

        <section class="summary-cards">

            <div class="summary-card">
                <h4>Current Stocks</h4>
                <p id="current-stocks">0</p>
            </div>

            <div class="summary-card">
                <h4>Low Stocks</h4>
                <p id="low-stocks">0</p>
            </div>

            <div class="summary-card">
                <h4>Expiration Reminder</h4>
                <p id="expiration-reminder">0</p>
            </div>

        </section>

        <section class="inventory-controls">

            <div class="search-form">

                <input
                    type="search"
                    id="inventory-search"
                    name="search"
                    placeholder="Search item / product"
                >

                <select id="status-filter">
                    <option value="all">All Status</option>
                    <option value="low">Low</option>
                    <option value="normal">Normal</option>
                    <option value="high">High</option>
                </select>

            </div>

            <a href="/inventory/add" class="add-button">
                Add Product
            </a>

        </section>

        <section class="inventory-list">

            <table>

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Stock</th>
                        <th>Status</th>
                        <th>Expiration</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="inventory-table-body">

                    <% products.forEach(function(product) { %>

                        <tr
                            class="inventory-row"
                            data-product="<%= product.name %>"
                            data-status="<%= product.status %>"
                            data-stock="<%= product.stock %>"
                            data-expiring="<%= product.expiring %>"
                        >

                            <td><%= product.name %></td>

                            <td><%= product.stock %></td>

                            <td class="status-<%= product.status %>">
                                <%= product.status.charAt(0).toUpperCase() + product.status.slice(1) %>
                            </td>

                            <td><%= product.expiration %></td>

                            <td>
                                <a href="/inventory/edit/<%= product.id %>">Edit</a>
                            </td>

                        </tr>

                    <% }); %>

                </tbody>

            </table>

            <p id="inventory-no-results" hidden>
                No products found.
            </p>

        </section>

    </main>

    <script src="/script.js"></script>

</body>

</html>