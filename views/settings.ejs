<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Settings</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header class="top-header">
        <h2>StockWise POS</h2>
        <div class="user">USER</div>
    </header>

    <aside class="sidebar">

        <nav>
            <a href="/dashboard">HOME</a>
            <a href="/order">ORDERS</a>
            <a href="/inventory">INVENTORY</a>
            <a href="/reports">REPORTS</a>
            <a href="/rewards">REWARD</a>

            <div class="sidebar-bottom">

                <a href="/notifications">
                    NOTIFICATIONS
                </a>

                <a href="/settings" class="active">
                    SETTINGS
                </a>

                <footer>
                    <a href="/login">
                        LOGOUT
                    </a>
                </footer>

            </div>

        </nav>

    </aside>

    <main class="settings-page">

        <h1 class="page-title">
            Settings
        </h1>


        <!-- =========================================
             ACCOUNT / PROFILE
        ========================================= -->

        <section class="settings-section">

            <h3>Account / Profile</h3>

            <p class="section-desc">
                Update your personal information and how your
                account appears in StockWise.
            </p>

            <form
                class="settings-form"
                id="profile-settings-form"
            >

                <div class="form-row">

                    <label for="settings-full-name">
                        Full Name
                    </label>

                    <input
                        type="text"
                        id="settings-full-name"
                        name="full-name"
                        placeholder="Juan Dela Cruz"
                        value="<%= settings.fullName %>"
                        required
                    >

                </div>

                <div class="form-row">

                    <label for="settings-email">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="settings-email"
                        name="email"
                        placeholder="juan@stockwise.com"
                        value="<%= settings.email %>"
                        required
                    >

                </div>

                <div class="form-row">

                    <label for="settings-role">
                        Role
                    </label>

                    <select
                        id="settings-role"
                        name="role"
                    >

                        <option
                            value="owner"
                            <%= settings.role === "owner" ? "selected" : "" %>
                        >
                            Owner
                        </option>

                        <option
                            value="manager"
                            <%= settings.role === "manager" ? "selected" : "" %>
                        >
                            Manager
                        </option>

                        <option
                            value="store-staff"
                            <%= settings.role === "store-staff" ? "selected" : "" %>
                        >
                            Store Staff
                        </option>

                        <option
                            value="cashier"
                            <%= settings.role === "cashier" ? "selected" : "" %>
                        >
                            Cashier
                        </option>

                    </select>

                </div>

                <p
                    id="profile-settings-message"
                    class="form-message"
                    hidden
                ></p>

                <button
                    type="submit"
                    class="save-button"
                >
                    Save Changes
                </button>

            </form>

        </section>


        <!-- =========================================
             SYSTEM PREFERENCES
        ========================================= -->

        <section class="settings-section">

            <h3>System Preferences</h3>

            <p class="section-desc">
                Adjust how StockWise displays store data.
            </p>

            <form
                class="settings-form"
                id="system-preferences-form"
            >

                <div class="form-row">

                    <label for="currency">
                        Currency
                    </label>

                    <select
                        id="currency"
                        name="currency"
                    >

                        <option
                            value="php"
                            <%= settings.currency === "php" ? "selected" : "" %>
                        >
                            PHP (₱)
                        </option>

                        <option
                            value="usd"
                            <%= settings.currency === "usd" ? "selected" : "" %>
                        >
                            USD ($)
                        </option>

                    </select>

                </div>

                <div class="form-row">

                    <label for="low-stock-threshold">
                        Low Stock Threshold
                    </label>

                    <input
                        type="number"
                        id="low-stock-threshold"
                        name="low-stock-threshold"
                        value="<%= settings.lowStockThreshold %>"
                        min="0"
                        step="1"
                    >

                </div>

                <div class="form-row">

                    <label for="language">
                        Language
                    </label>

                    <select
                        id="language"
                        name="language"
                    >

                        <option
                            value="en"
                            <%= settings.language === "en" ? "selected" : "" %>
                        >
                            English
                        </option>

                        <option
                            value="fil"
                            <%= settings.language === "fil" ? "selected" : "" %>
                        >
                            Filipino
                        </option>

                    </select>

                </div>

                <p
                    id="system-preferences-message"
                    class="form-message"
                    hidden
                ></p>

                <button
                    type="submit"
                    class="save-button"
                >
                    Save Preferences
                </button>

            </form>

        </section>


        <!-- =========================================
             NOTIFICATION PREFERENCES
        ========================================= -->

        <section class="settings-section">

            <h3>Notification Preferences</h3>

            <p class="section-desc">
                Choose which alerts you want to receive
                from StockWise.
            </p>

            <form id="notification-preferences-form">

                <div class="toggle-list">

                    <label class="toggle-row">

                        <span>
                            Low Stock Alerts
                        </span>

                        <input
                            type="checkbox"
                            id="low-stock-alerts"
                            <%= settings.notifications.lowStock ? "checked" : "" %>
                        >

                    </label>

                    <label class="toggle-row">

                        <span>
                            Completed Order Notifications
                        </span>

                        <input
                            type="checkbox"
                            id="order-notifications"
                            <%= settings.notifications.orders ? "checked" : "" %>
                        >

                    </label>

                    <label class="toggle-row">

                        <span>
                            Expiration Reminders
                        </span>

                        <input
                            type="checkbox"
                            id="expiration-reminders"
                            <%= settings.notifications.expiration ? "checked" : "" %>
                        >

                    </label>

                    <label class="toggle-row">

                        <span>
                            System Updates
                        </span>

                        <input
                            type="checkbox"
                            id="system-updates"
                            <%= settings.notifications.systemUpdates ? "checked" : "" %>
                        >

                    </label>

                </div>

                <p
                    id="notification-preferences-message"
                    class="form-message"
                    hidden
                ></p>

                <button
                    type="submit"
                    class="save-button"
                >
                    Save Notifications
                </button>

            </form>

        </section>


        <!-- =========================================
             SECURITY
        ========================================= -->

        <section class="settings-section">

            <h3>Security</h3>

            <p class="section-desc">
                Change your password to keep your
                account secure.
            </p>

            <form
                class="settings-form"
                id="password-settings-form"
            >

                <div class="form-row">

                    <label for="current-password">
                        Current Password
                    </label>

                    <input
                        type="password"
                        id="current-password"
                        name="current-password"
                        autocomplete="current-password"
                    >

                </div>

                <div class="form-row">

                    <label for="new-password">
                        New Password
                    </label>

                    <input
                        type="password"
                        id="new-password"
                        name="new-password"
                        autocomplete="new-password"
                    >

                </div>

                <div class="form-row">

                    <label for="confirm-password">
                        Confirm New Password
                    </label>

                    <input
                        type="password"
                        id="confirm-password"
                        name="confirm-password"
                        autocomplete="new-password"
                    >

                </div>

                <p
                    id="password-settings-message"
                    class="form-message"
                    hidden
                ></p>

                <button
                    type="submit"
                    class="save-button"
                >
                    Update Password
                </button>

            </form>

        </section>

    </main>

    <script src="/script.js"></script>

</body>

</html>