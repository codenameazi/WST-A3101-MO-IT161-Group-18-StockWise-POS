<!DOCTYPE html>
<html>

<head>
    <title>Order</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { active: 'order' }) %>

    <main class="order-page">

        <section class="order-content">

            <div class="search-area">

                <form onsubmit="return false;">

                    <input
                        type="search"
                        id="search"
                        name="search"
                        placeholder="Search product"
                    >

                    <button type="button">
                        Scan Item / Barcode
                    </button>

                </form>

            </div>

            <h3 class="category-title">Products</h3>

            <div class="product-grid">

                <% products.forEach(function (product) { %>

                    <button
                        type="button"
                        class="product-button"
                        data-name="<%= product.name %>"
                        data-price="<%= product.price %>"
                    >
                        <%= product.name %><br>
                        ₱<%= product.price.toFixed(2) %>
                    </button>

                <% }); %>

            </div>

        </section>

        <section class="order-list">

            <h3>Customer Order List</h3>

            <p id="empty-order">
                No items added yet.
            </p>

            <div
                class="order-items"
                id="order-items"
            ></div>

            <div class="order-total">

                <strong>Total</strong>

                <strong id="order-total">
                    ₱0.00
                </strong>

            </div>

            <div class="order-actions">

                <a
                    href="/complete-order"
                    class="complete-button"
                    id="complete-order"
                >
                    Complete
                </a>

                <button
                    type="button"
                    class="remove-button"
                    id="remove-item"
                >
                    Remove
                </button>

            </div>

        </section>

    </main>

    <script src="/script.js"></script>

</body>

</html>