<!DOCTYPE html>
<html>

<head>
    <title>Complete Order</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include('partials/header') %>

    <%- include('partials/sidebar', { active: 'order' }) %>

    <main class="complete-order-page">

        <section class="card">

            <h3>Order List</h3>

            <div class="order-items" id="co-order-items"></div>

            <p>
                <strong>Total</strong>
                <span id="co-order-total">₱0.00</span>
            </p>

        </section>

        <section class="card">

            <h3>Payment Method</h3>

            <button type="button" class="payment-button" data-method="Cash">Cash</button>
            <button type="button" class="payment-button" data-method="Split Payment">Split Payment</button>
            <button type="button" class="payment-button" data-method="E-Wallet">E-Wallet</button>

        </section>

        <section class="card">

            <button type="button" id="print-receipt">
                Print
            </button>

        </section>

        <section class="card">

            <div class="page-actions">

                <a href="/order" class="back-button">
                    Back
                </a>

                <button type="button" class="remove-button" id="cancel-order">
                    Cancel
                </button>

                <a href="/order" class="new-order-button" id="new-order">
                    New Order
                </a>

            </div>

        </section>

    </main>

    <script src="/script.js"></script>

</body>

</html>